node_modules/

# Built WebVST module (scripts/build.ts); intermediates live outside the repo.
build/

# Staged per-category preset artifacts (scripts/pack-presets.ts). ~23 MB of
# sliced Surge factory state; regenerated by `pnpm run pack-presets` and by the
# .webvst archive build. The packer + package/webvst.config.json are committed;
# these generated bytes are not.
package/presets/

# Final .webvst package and its checksum sidecar (scripts/build.ts). Built from
# the module in build/ and the packed presets; regenerated by `pnpm run build`.
dist/
